<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:wsc="http://www.mulesoft.org/schema/mule/wsc"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/wsc http://www.mulesoft.org/schema/mule/wsc/current/mule-wsc.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ================= LISTENERS ================= -->

    <http:listener-config name="HTTP_PUBLIC">
        <http:listener-connection host="0.0.0.0" port="33610"/>
    </http:listener-config>

    <http:listener-config name="HTTP_INTERNAL">
        <http:listener-connection host="0.0.0.0" port="33620"/>
    </http:listener-config>

    <!-- ================= FIRST SERVICE ================= -->

    <http:request-config name="HTTP_FIRST_SERVICE">
        <http:request-connection host="localhost" port="33510" protocol="HTTP"/>
    </http:request-config>

    <!-- ================= SECOND SERVICE (SOAP) ================= -->

    <wsc:config name="SOAP_SECOND_SERVICE">
        <wsc:connection wsdlLocation="classpath:wsdl/FlatProxyService.wsdl"
                        service="FlatProxyService"
                        port="FlatProxySoapBeanPort"/>
    </wsc:config>

    <!-- ========================================================= -->
    <!-- PUBLIC: frontend -> Mule -> SOAP(second) -> XML frontend -->
    <!-- ========================================================= -->

    <flow name="public-find-with-balcony">

        <http:listener config-ref="HTTP_PUBLIC"
                       path="/api/v1/flats/agency/find-with-balcony/{priceType}/{balconyType}"
                       allowedMethods="GET">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
        </http:listener>

        <wsc:consume config-ref="SOAP_SECOND_SERVICE" operation="findWithBalcony">
            <wsc:message>
                <wsc:body><![CDATA[
%dw 2.0
output application/xml
ns ns0 http://soap.soa.lab/
---
ns0#findWithBalcony: {
    ns0#arg0: attributes.uriParams.priceType,
    ns0#arg1: attributes.uriParams.balconyType
}
]]></wsc:body>
            </wsc:message>
        </wsc:consume>

        <!-- Извлекаем ProxyResponseDto -->
        <set-variable variableName="proxy" value="#[payload.return]" />

        <!-- Устанавливаем HTTP статус -->
        <set-variable variableName="httpStatus" value="#[vars.proxy.status]" />

        <!-- Устанавливаем Content-Type -->
        <set-variable variableName="outboundHeaders"
                      value="#[{ 'Content-Type' : vars.proxy.mediaType default 'application/xml' }]" />

        <!-- Возвращаем чистый XML из body -->
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/xml
---
read(vars.proxy.body, "application/xml")
]]></ee:set-payload>
            </ee:message>
        </ee:transform>

    </flow>


    <flow name="public-get-ordered-by-time-to-metro">

        <http:listener config-ref="HTTP_PUBLIC"
                       path="/api/v1/flats/agency/get-ordered-by-time-to-metro/{transportType}/{sortType}"
                       allowedMethods="GET">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
        </http:listener>

        <wsc:consume config-ref="SOAP_SECOND_SERVICE" operation="getOrderedByTimeToMetro">
            <wsc:message>
                <wsc:body><![CDATA[
%dw 2.0
output application/xml
ns ns0 http://soap.soa.lab/
---
ns0#getOrderedByTimeToMetro: {
    ns0#arg0: attributes.uriParams.transportType,
    ns0#arg1: attributes.uriParams.sortType
}
]]></wsc:body>
            </wsc:message>
        </wsc:consume>

        <set-variable variableName="proxy" value="#[payload.return]" />
        <set-variable variableName="httpStatus" value="#[vars.proxy.status]" />
        <set-variable variableName="outboundHeaders"
                      value="#[{ 'Content-Type' : vars.proxy.mediaType default 'application/xml' }]" />

        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/xml
---
read(vars.proxy.body, "application/xml")
]]></ee:set-payload>
            </ee:message>
        </ee:transform>

    </flow>

    <!-- ========================================================= -->
    <!-- INTERNAL: second -> Mule -> first -> wrap in ProxyResponseDto -->
    <!-- ========================================================= -->

    <flow name="internal-find-with-balcony">

        <http:listener config-ref="HTTP_INTERNAL"
                       path="/internal/find-with-balcony"
                       allowedMethods="GET"/>

        <http:request config-ref="HTTP_FIRST_SERVICE"
                      path="/api/v1/flats/agency/find-with-balcony"
                      method="GET">
            <http:body><![CDATA[#[payload]]]></http:body>
            <http:headers>#[{ 'Content-Type': 'application/xml' }]</http:headers>
        </http:request>

        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/xml
ns ns0 http://soap.soa.lab/
---
ns0#findWithBalconyResponse: {
  ns0#return: {
    ns0#status: 200,
    ns0#mediaType: "application/xml",
    ns0#body: write(payload, "application/xml")
  }
}
]]></ee:set-payload>
            </ee:message>
        </ee:transform>

    </flow>


    <flow name="internal-get-ordered-by-time-to-metro">

        <http:listener config-ref="HTTP_INTERNAL"
                       path="/internal/get-ordered-by-time-to-metro"
                       allowedMethods="GET"/>

        <http:request config-ref="HTTP_FIRST_SERVICE"
                      path="/api/v1/flats/agency/get-ordered-by-time-to-metro"
                      method="GET">
            <http:body><![CDATA[#[payload]]]></http:body>
            <http:headers>#[{ 'Content-Type': 'application/xml' }]</http:headers>
        </http:request>

        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/xml
ns ns0 http://soap.soa.lab/
---
ns0#getOrderedByTimeToMetroResponse: {
  ns0#return: {
    ns0#status: 200,
    ns0#mediaType: "application/xml",
    ns0#body: write(payload, "application/xml")
  }
}
]]></ee:set-payload>
            </ee:message>
        </ee:transform>

    </flow>

</mule>
