<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ws="http://www.mulesoft.org/schema/mule/ws"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ws http://www.mulesoft.org/schema/mule/ws/current/mule-ws.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ========== КОНФИГУРАЦИИ СОЕДИНЕНИЙ ========== -->
    <!-- HTTP-прослушивание для интеграции (порт 8082) -->
    <http:listener-config name="HTTP_Listener_Config">
        <http:listener-connection host="0.0.0.0" port="8082" />
    </http:listener-config>

    <!-- HTTP-прослушивание для REST-прослойки (порт 8083) -->
    <http:listener-config name="HTTP_Listener_Config_REST">
        <http:listener-connection host="0.0.0.0" port="8083" />
    </http:listener-config>

    <!-- HTTP-клиент для вызовов первого сервиса (REST) -->
    <http:request-config name="HTTP_Request_Config">
        <http:request-connection host="first-service-host" port="8080" protocol="HTTP" />
    </http:request-config>

    <!-- SOAP-клиент для вызова второго сервиса -->
    <ws:consumer-config name="Web_Service_Consumer"
                        wsdlLocation="http://second-service-host:8080/second-service/FlatProxyService?wsdl"
                        service="FlatProxyService"
                        port="FlatProxySoapPort">
        <ws:connection />
    </ws:consumer-config>

    <!-- ========== FLOW 1: Прокси от второго сервиса к первому ========== -->
    <flow name="proxy-to-first-service">
        <http:listener config-ref="HTTP_Listener_Config"
                       path="api/v1/flats/agency/{method}/{param1}/{param2}"
                       allowedMethods="GET" />
        
        <!-- Сохраняем параметры пути и query -->
        <set-variable variableName="method" value="#[attributes.uriParams.method]" />
        <set-variable variableName="param1" value="#[attributes.uriParams.param1]" />
        <set-variable variableName="param2" value="#[attributes.uriParams.param2]" />

        <!-- Формируем путь для первого сервиса -->
        <set-variable variableName="targetPath"
                      value="#['/api/v1/flats/agency/' ++ vars.method ++ '/' ++ vars.param1 ++ '/' ++ vars.param2]" />

        <!-- Выполняем GET-запрос к первому сервису, передавая query-параметры -->
        <http:request config-ref="HTTP_Request_Config"
                      path="#[vars.targetPath]"
                      method="GET">
            <http:query-params>#[attributes.queryParams]</http:query-params>
        </http:request>

        <!-- Обработка ошибок -->
        <error-handler>
            <on-error-continue type="HTTP:NOT_FOUND">
                <set-payload value="#[{status: 404, body: 'Not Found'}]" />
            </on-error-continue>
            <on-error-continue type="ANY">
                <set-payload value="#[{status: 500, body: 'Internal Server Error'}]" />
            </on-error-continue>
        </error-handler>
    </flow>

    <!-- ========== FLOW 2: REST-прослойка для клиента ========== -->
    <flow name="rest-to-soap-proxy">
        <http:listener config-ref="Web_Service_Consumer"
                       path="api/v1/flats/agency/{method}/{param1}/{param2}"
                       allowedMethods="GET" />
        
        <!-- Сохраняем параметры -->
        <set-variable variableName="method" value="#[attributes.uriParams.method]" />
        <set-variable variableName="param1" value="#[attributes.uriParams.param1]" />
        <set-variable variableName="param2" value="#[attributes.uriParams.param2]" />
        <set-variable variableName="page" value="#[attributes.queryParams.page[0]]" />
        <set-variable variableName="size" value="#[attributes.queryParams.size[0]]" />

        <!-- Выбор SOAP-операции -->
        <choice>
            <when expression="#[vars.method == 'find-with-balcony']">
                <ws:consumer config-ref="Web_Service_Consumer"
                             operation="findWithBalcony">
                    <ws:args>
                        <ws:arg value="#[vars.param1]" />  <!-- priceType -->
                        <ws:arg value="#[vars.param2]" />  <!-- balconyType -->
                    </ws:args>
                </ws:consumer>
            </when>
            <when expression="#[vars.method == 'get-ordered-by-time-to-metro']">
                <ws:consumer config-ref="Web_Service_Consumer"
                             operation="getOrderedByTimeToMetro">
                    <ws:args>
                        <ws:arg value="#[vars.param1]" />                     <!-- transportType -->
                        <ws:arg value="#[vars.param2]" />                     <!-- sortType -->
                        <ws:arg value="#[if (vars.page? != null) vars.page else null]" />
                        <ws:arg value="#[if (vars.size? != null) vars.size else null]" />
                    </ws:args>
                </ws:consumer>
            </when>
            <otherwise>
                <raise-error type="HTTP:NOT_FOUND" description="Unknown method" />
            </otherwise>
        </choice>

        <!-- Преобразуем SOAP-ответ (ProxyResponseDto) в HTTP-ответ -->
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[
                    %dw 2.0
                    output application/java
                    ---
                    {
                        status: payload.status,
                        mediaType: payload.mediaType,
                        body: payload.body
                    }
                ]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <!-- Устанавливаем HTTP-статус и заголовок Content-Type -->
        <set-property propertyName="http.status" value="#[payload.status]" />
        <set-property propertyName="Content-Type" value="#[payload.mediaType]" />

        <!-- Тело ответа берём из поля body (это уже XML от первого сервиса) -->
        <set-payload value="#[payload.body]" />

        <!-- Обработка ошибок SOAP -->
        <error-handler>
            <on-error-continue type="WS:CONSUMER_FAILURE">
                <set-property propertyName="http.status" value="500" />
                <set-payload value="&lt;error&gt;SOAP service error&lt;/error&gt;" />
            </on-error-continue>
        </error-handler>
    </flow>

</mule>
