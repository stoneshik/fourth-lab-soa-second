<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:wsc="http://www.mulesoft.org/schema/mule/wsc"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/wsc http://www.mulesoft.org/schema/mule/wsc/current/mule-wsc.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ================= CONFIGS ================= -->

    <http:listener-config name="HTTP_PUBLIC">
        <http:listener-connection host="0.0.0.0" port="33610"/>
    </http:listener-config>

    <http:listener-config name="HTTP_INTERNAL">
        <http:listener-connection host="0.0.0.0" port="33620"/>
    </http:listener-config>

    <http:request-config name="HTTP_FIRST_SERVICE">
        <http:request-connection host="localhost" port="33510" protocol="HTTP"/>
    </http:request-config>

    <!-- SOAP SECOND SERVICE (WSDL via HTTP) -->
    <wsc:config name="SOAP_SECOND_SERVICE">
        <wsc:connection
            wsdlLocation="wsdl/FlatProxyService.wsdl"
            service="FlatProxyService"
            port="FlatProxySoapBeanPort"
            address="http://localhost:33612/FlatProxyService/FlatProxySoapBean"/>
    </wsc:config>

    <!-- ========================================================= -->
    <!-- PUBLIC API -->
    <!-- ========================================================= -->

    <!-- ===== find-with-balcony ===== -->
    <flow name="public-find-with-balcony">
        <http:listener config-ref="HTTP_PUBLIC"
                       path="/api/v1/flats/agency/find-with-balcony/{priceType}/{balconyType}"
                       allowedMethods="GET">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.headers default {}]</http:headers>
            </http:response>
        </http:listener>

        <!-- Build SOAP body -->
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/xml
ns ns0 http://soap.soa.lab/
---
ns0#findWithBalcony: {
    arg0: attributes.uriParams.priceType,
    arg1: attributes.uriParams.balconyType
}
]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <wsc:consume config-ref="SOAP_SECOND_SERVICE" operation="findWithBalcony"/>

        <set-variable variableName="resp" value="#[payload.return]" />
        <set-variable variableName="httpStatus" value="#[(vars.resp.status default 200) as Number]" />
        <set-variable variableName="headers"
                      value="#[{ 'Content-Type': (vars.resp.mediaType default 'application/xml') }]" />

        <!-- Safe transform: return parsed body if present, otherwise emptyResponse -->
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/xml
---
if (vars.resp? and vars.resp.body != null and vars.resp.body != "")
    read(vars.resp.body, "application/xml")
else
    { emptyResponse: {} }
]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

    <!-- ===== get-ordered-by-time-to-metro ===== -->
    <flow name="public-get-ordered-by-time-to-metro">
        <http:listener config-ref="HTTP_PUBLIC"
                       path="/api/v1/flats/agency/get-ordered-by-time-to-metro/{transportType}/{sortType}"
                       allowedMethods="GET">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.headers default {}]</http:headers>
            </http:response>
        </http:listener>

        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/xml
ns ns0 http://soap.soa.lab/

var page = attributes.queryParams.page default null
var size = attributes.queryParams.size default null

---
ns0#getOrderedByTimeToMetro: {
    arg0: attributes.uriParams.transportType,
    arg1: attributes.uriParams.sortType
} ++
(if (page != null) { arg2: page as Number } else {}) ++
(if (size != null) { arg3: size as Number } else {})
]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <wsc:consume config-ref="SOAP_SECOND_SERVICE" operation="getOrderedByTimeToMetro"/>

        <set-variable variableName="resp" value="#[payload.return]" />
        <set-variable variableName="httpStatus" value="#[(vars.resp.status default 200) as Number]" />
        <set-variable variableName="headers"
                      value="#[{ 'Content-Type': (vars.resp.mediaType default 'application/xml') }]" />

        <!-- Safe transform: return parsed body if present, otherwise emptyResponse -->
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/xml
---
if (vars.resp? and vars.resp.body != null and vars.resp.body != "")
    read(vars.resp.body, "application/xml")
else
    { emptyResponse: {} }
]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

    <!-- ========================================================= -->
    <!-- INTERNAL PROXY (GET -> FIRST REST SERVICE) -->
    <!-- ========================================================= -->

    <flow name="internal-find-with-balcony">
        <http:listener config-ref="HTTP_INTERNAL"
                       path="/api/v1/flats/agency/find-with-balcony/{priceType}/{balconyType}"
                       allowedMethods="GET"/>

        <http:request config-ref="HTTP_FIRST_SERVICE"
                      path="/api/v1/flats/agency/find-with-balcony/{priceType}/{balconyType}"
                      method="GET">
            <http:uri-params><![CDATA[#[{
                priceType: attributes.uriParams.priceType,
                balconyType: attributes.uriParams.balconyType
            }]]]></http:uri-params>
        </http:request>

        <set-variable variableName="resp" value="#[payload]" />
        <set-variable variableName="httpStatus" value="200" />
        <set-variable variableName="headers" value="#[{ 'Content-Type': 'application/xml' }]" />
    </flow>

    <flow name="internal-get-ordered-by-time-to-metro">
	    <http:listener config-ref="HTTP_INTERNAL"
	                   path="/api/v1/flats/agency/get-ordered-by-time-to-metro/{transportType}/{sortType}"
	                   allowedMethods="GET"/>
	
	    <http:request config-ref="HTTP_FIRST_SERVICE"
	                  path="/api/v1/flats/agency/get-ordered-by-time-to-metro/{transportType}/{sortType}"
	                  method="GET">
	        <http:uri-params><![CDATA[#[{
	            transportType: attributes.uriParams.transportType,
	            sortType: attributes.uriParams.sortType
	        }]]]></http:uri-params>
	
	        <http:query-params><![CDATA[#[{
	            (if (attributes.queryParams.page != null) 'page' else 0): attributes.queryParams.page,
	            (if (attributes.queryParams.size != null) 'size' else 10): attributes.queryParams.size
	        }]]]></http:query-params>
	    </http:request>
	
	    <set-variable variableName="resp" value="#[payload]" />
	    <set-variable variableName="httpStatus" value="200" />
	    <set-variable variableName="headers" value="#[{ 'Content-Type': 'application/xml' }]" />
	</flow>

</mule>
