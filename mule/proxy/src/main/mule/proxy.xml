<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:wsc="http://www.mulesoft.org/schema/mule/wsc"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/wsc http://www.mulesoft.org/schema/mule/wsc/current/mule-wsc.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ================================================= -->
    <!-- GLOBAL CONFIG                                     -->
    <!-- ================================================= -->
    <http:listener-config name="HTTP_Listener_config">
        <http:listener-connection host="0.0.0.0" port="33610"/>
    </http:listener-config>

    <wsc:config name="Soap_Config"
                wsdlLocation="wsdl/FlatProxyService.wsdl"
                service="FlatProxyService"
                port="FlatProxyServicePort">
        <wsc:connection endpoint="http://localhost:33612/FlatProxyService/FlatProxySoapBean"/>
    </wsc:config>


    <!-- ================================================= -->
    <!-- FLOW 1: find-with-balcony                        -->
    <!-- ================================================= -->
    <flow name="findWithBalconyFlow">
        <http:listener config-ref="HTTP_Listener_config"
                       path="/api/v1/flats/agency/find-with-balcony/{priceType}/{balconyType}"
                       allowedMethods="GET"/>

        <set-variable variableName="priceType" value="#[attributes.uriParams.priceType]"/>
        <set-variable variableName="balconyType" value="#[attributes.uriParams.balconyType]"/>

        <wsc:consume config-ref="Soap_Config" operation="findWithBalcony">
            <wsc:message>
                <wsc:body>
<![CDATA[
%dw 2.0
output application/xml
---
{
 findWithBalcony: {
  priceType: vars.priceType,
  balconyType: vars.balconyType
 }
}
]]>
                </wsc:body>
            </wsc:message>
        </wsc:consume>

        <!-- extract ProxyResponseDto -->
        <ee:transform>
            <ee:message>
                <ee:set-payload>
<![CDATA[
%dw 2.0
output application/java
---
{
 status: payload.Body.return.status as Number,
 mediaType: payload.Body.return.mediaType as String,
 body: payload.Body.return.body as String
}
]]>
                </ee:set-payload>
            </ee:message>
        </ee:transform>

        <!-- build REST response -->
        <ee:transform>
            <ee:message>
                <ee:set-payload>
<![CDATA[
%dw 2.0
output application/xml
---
read(payload.body,"application/xml")
]]>
                </ee:set-payload>
                <ee:set-attributes>
<![CDATA[
%dw 2.0
output application/java
---
attributes ++ {
 statusCode: payload.status,
 headers: { "Content-Type": payload.mediaType }
}
]]>
                </ee:set-attributes>
            </ee:message>
        </ee:transform>
    </flow>


    <!-- ================================================= -->
    <!-- FLOW 2: get-ordered-by-time-to-metro            -->
    <!-- ================================================= -->
    <flow name="orderedByMetroFlow">
        <http:listener config-ref="HTTP_Listener_config"
                       path="/api/v1/flats/agency/get-ordered-by-time-to-metro/{transportType}/{sortType}"
                       allowedMethods="GET"/>

        <set-variable variableName="transportType" value="#[attributes.uriParams.transportType]"/>
        <set-variable variableName="sortType" value="#[attributes.uriParams.sortType]"/>
        <set-variable variableName="page" value="#[attributes.queryParams.page default 0]"/>
        <set-variable variableName="size" value="#[attributes.queryParams.size default 10]"/>

        <wsc:consume config-ref="Soap_Config" operation="getOrderedByTimeToMetro">
            <wsc:message>
                <wsc:body>
<![CDATA[
%dw 2.0
output application/xml
---
{
 getOrderedByTimeToMetro: {
  transportType: vars.transportType,
  sortType: vars.sortType,
  page: vars.page,
  size: vars.size
 }
}
]]>
                </wsc:body>
            </wsc:message>
        </wsc:consume>

        <ee:transform>
            <ee:message>
                <ee:set-payload>
<![CDATA[
%dw 2.0
output application/java
---
{
 status: payload.Body.return.status as Number,
 mediaType: payload.Body.return.mediaType as String,
 body: payload.Body.return.body as String
}
]]>
                </ee:set-payload>
            </ee:message>
        </ee:transform>

        <ee:transform>
            <ee:message>
                <ee:set-payload>
<![CDATA[
%dw 2.0
output application/xml
---
read(payload.body,"application/xml")
]]>
                </ee:set-payload>
                <ee:set-attributes>
<![CDATA[
%dw 2.0
output application/java
---
attributes ++ {
 statusCode: payload.status,
 headers: { "Content-Type": payload.mediaType }
}
]]>
                </ee:set-attributes>
            </ee:message>
        </ee:transform>
    </flow>

</mule>
